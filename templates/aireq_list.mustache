{{!
    @template mod_aisafetyhazards/aireq_list

    Stored LMS Labs requests that need the teacher's attention (pending, unconfirmed, conflicting, expired or lost).

    Example context (json):
    {
        "cmid": 1,
        "requests": [{"id": 3, "operation": "image", "status": "pending", "title": "Behind on the target",
            "message": "LMS Labs is still creating this picture.", "requestid": "abc", "canrecheck": true,
            "candismiss": true, "poll": true, "retryafter": 5, "sceneid": 4, "sceneurl": "", "openscene": false,
            "timecreated": "Monday"}]
    }
}}
<div class="sh-aireqs" data-region="aireqs" data-cmid="{{cmid}}"{{^requests}} hidden{{/requests}}>
    <h3 class="h5">{{#str}} aireq_heading, mod_aisafetyhazards {{/str}}</h3>
    <div class="sh-aireq-list" data-region="aireqlist">
        {{#requests}}{{> mod_aisafetyhazards/aireq_item}}{{/requests}}
    </div>
</div>
