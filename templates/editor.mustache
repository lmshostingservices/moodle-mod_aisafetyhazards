{{!
    @template mod_aisafetyhazards/editor

    Set-up step 6, one scene: the picture with its hazard spots, the scene text, and each hazard with its rows of
    control labels. The editor itself is built by mod_aisafetyhazards/editor from the scene's data.

    Example context (json):
    {"title": "Digging the trench", "image": "", "backurl": "#", "replaceurl": "#", "datajson": "{}", "rtl": false,
     "bar": {"current": 6, "total": 7, "steps": [{"number": 6, "name": "Check the scenes", "done": false, "current": true, "dot": 0}]} }
}}
<div class="sh-editor" id="sh-editor" data-scene="{{datajson}}" {{#rtl}}dir="rtl"{{/rtl}}>
    <div class="sh-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_aisafetyhazards {{/str}}</h2>
        {{#bar}}{{> mod_aisafetyhazards/setup_steps}}{{/bar}}
    </div>
    <div class="sh-ed-top">
        <a class="sh-btn sh-btn-ghost sh-btn-sm" href="{{backurl}}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            <span>{{#str}} editor_back, mod_aisafetyhazards {{/str}}</span>
        </a>
        <h3 class="sh-ed-title" dir="auto">{{title}}</h3>
    </div>
    <div class="sh-ed-layout">
        <section class="sh-ed-picture" data-region="picture" aria-labelledby="sh-ed-pichead">
            <h4 id="sh-ed-pichead">{{#str}} editor_spots, mod_aisafetyhazards {{/str}}</h4>
            <p class="sh-mini">{{#str}} editor_spots_help, mod_aisafetyhazards {{/str}}</p>
            {{#image}}
            <div class="sh-ed-figure" data-region="figure">
                <img src="{{image}}" alt="" draggable="false">
            </div>
            {{/image}}
            {{^image}}<p class="sh-note">{{#str}} editor_noimage, mod_aisafetyhazards {{/str}}</p>{{/image}}
            <a class="sh-btn sh-btn-ghost sh-btn-sm mt-2" href="{{replaceurl}}">{{#str}} uploadownimage, mod_aisafetyhazards {{/str}}</a>
        </section>
        <section class="sh-ed-content" data-region="content" aria-live="off"></section>
    </div>
    <div class="sh-ed-save">
        <p class="sh-ed-status" data-region="status" role="status"></p>
        <button type="button" class="sh-btn sh-btn-primary" data-action="save">{{#str}} editor_save, mod_aisafetyhazards {{/str}}</button>
    </div>
</div>
