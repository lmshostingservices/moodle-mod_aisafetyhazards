{{!
    @template mod_aisafetyhazards/setup_finish

    Set-up step 8: what is ready, what is still missing, preview as a learner, done.

    Example context (json):
    {
        "bar": {"current": 8, "total": 8, "steps": [{"number": 8, "name": "Finish", "done": false, "current": true, "dot": 0}]},
        "title": "Finish", "ready": 8, "scenes": 8, "allready": true, "todo": [], "warn": [], "viewurl": "#", "courseurl": "#",
        "nav": {"backurl": "#", "backlabel": "Back", "nexturl": null, "nextlabel": "", "blocked": ""}
    }
}}
<div class="sh-wizard sh-finish">
    <div class="sh-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_aisafetyhazards {{/str}}</h2>
        {{#bar}}{{> mod_aisafetyhazards/setup_steps}}{{/bar}}
    </div>
    <div class="sh-wstep">
        <h3 class="sh-wstep-title">{{#allready}}{{#str}} finish_ready, mod_aisafetyhazards, {{ready}} {{/str}}{{/allready}}{{^allready}}{{#str}} finish_notready, mod_aisafetyhazards, { "ready": {{ready}}, "scenes": {{scenes}} } {{/str}}{{/allready}}</h3>
        {{#allready}}<p>{{#str}} finish_ready_help, mod_aisafetyhazards {{/str}}</p>{{/allready}}
        {{#warn}}<p class="sh-finish-warn">{{.}}</p>{{/warn}}
        {{^allready}}
        <ul class="sh-finish-list">{{#todo}}<li>{{.}}</li>{{/todo}}</ul>
        <p class="sh-mini mt-2">{{#str}} finish_notready_help, mod_aisafetyhazards {{/str}}</p>
        {{/allready}}
        <div class="sh-setupnav">
            <a class="sh-btn sh-btn-ghost" href="{{viewurl}}">{{#str}} finish_preview, mod_aisafetyhazards {{/str}}</a>
            <span class="sh-grow"></span>
            <a class="sh-btn sh-btn-primary" href="{{courseurl}}">{{#str}} finish_done, mod_aisafetyhazards {{/str}}</a>
        </div>
    </div>
    {{> mod_aisafetyhazards/setup_nav}}
</div>
